# Database Configuration (PostgreSQL)
POSTGRES_DB=clientdesk
POSTGRES_USER=clientdesk_user
POSTGRES_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Security & JWT (минимум 32 символа)
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server & Logging
PORT=8080
EVENT_LOG_FILE=logs/events.log

